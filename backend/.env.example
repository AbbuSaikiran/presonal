# Sybrai Backend — Environment Variables
# Copy this file to .env and fill in your values.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL DSN (async asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sybrai

# ── JWT Auth ────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── AI & Anomaly Detection ──────────────────────────────────────────────────
# Anthropic Claude API Key for /explain endpoint (optional, defaults to local expert engine if omitted)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Anomaly threshold for /predict endpoint (0.0 - 1.0; default 0.65)
ANOMALY_THRESHOLD=0.65
